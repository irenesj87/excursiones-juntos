# Puerto en el que correrá el servidor
PORT=3001

# Secreto para firmar los JSON Web Tokens (JWT).
# ¡IMPORTANTE! Debes reemplazar esto por una cadena de texto larga y aleatoria.
JWT_SECRET=

# Orígenes permitidos para CORS (separados por comas).
# Para desarrollo, suele ser la URL del frontend. Ejemplo: http://localhost:3000
CORS_ALLOWED_ORIGINS=
