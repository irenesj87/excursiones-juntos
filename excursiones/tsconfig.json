{
	// Visit https://aka.ms/tsconfig to read more about this file
	"compilerOptions": {
		// --- Opciones Esenciales para React ---

		// Compila a una versión moderna de JavaScript para mejor rendimiento.
		"target": "ES2022",
		// Especifica las bibliotecas que se incluirán durante la compilación.
		"lib": ["dom", "dom.iterable", "esnext"],
		// Habilita el soporte para JSX
		"jsx": "react-jsx",
		// Usa el sistema de módulos moderno que los bundlers actuales esperan.
		"module": "esnext",
		// Recomendación oficial
		"moduleResolution": "bundler",
		// Permite importar archivos JavaScript.
		"allowJs": true,
		/**
		 * Cuando está activo se permite exportar módulos así: import React from 'react'; en vez de
		 * import * as React from 'react'; cuando el módulo no tiene una exportación por defecto.
		 */
		"allowSyntheticDefaultImports": true,
		"jsxImportSource": "react",

		// --- Opciones de Calidad de Código (Recomendadas) ---

		// Habilita todas las comprobaciones estrictas.
		"strict": true,
		"esModuleInterop": true,
		// Acelera la compilación omitiendo la revisión de librerías
		"skipLibCheck": true,
		// Evita problemas de mayúsculas/minúsculas en los nombres de archivos.
		"forceConsistentCasingInFileNames": true,
		// Evita errores silenciosos en switch sin 'break', 'return' o 'throw'.
		"noFallthroughCasesInSwitch": true,

		// --- Opciones para Bundlers Modernos (Vite, Create React App, etc.) ---

		// Permite importar archivos JSON como módulos.
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,

		// --- Resolución de Rutas (Moderno) ---

		// Mantenemos node para process.env.
		"types": ["node"],
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["src", "tailwind.config.js"]
}
